# RoleFit Canvas 환경 변수
#
# 아무것도 설정하지 않아도 앱은 전부 동작합니다.
# 분석 엔진과 이력서 생성은 브라우저에서 돌고, 파일도 기기 안에서 읽습니다.
# 아래 값들은 "더 할 수 있는 것"을 켜는 스위치입니다.

# ── Google 로그인 (선택) ───────────────────────────────────────
# 공개 클라이언트 ID 하나면 됩니다. 비밀키는 쓰지 않습니다.
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → 웹 애플리케이션
# 승인된 JavaScript 원본에 배포 주소를 넣으세요 (경로 없이 도메인만).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 관리자를 더 두고 싶을 때 (쉼표로 구분).
# linkedsugi@gmail.com 은 코드에 소유자로 고정되어 있어 여기 적지 않아도 됩니다.
NEXT_PUBLIC_ADMIN_EMAILS=

# ── 회원·설정 보관 (서버 배포에서만) ──────────────────────────
# 이 폴더 아래 members.json / settings.json 을 둡니다.
# Railway 에서는 볼륨을 붙이고 그 마운트 경로를 넣으세요 (예: /data).
# 비워 두면 서버 메모리에만 있어 재시작하면 사라집니다.
ROLEFIT_DATA_DIR=

# ── 정밀 분석 (선택, 서버 배포에서만) ─────────────────────────
# 설정하면 관리자가 /admin 에서 정밀 분석을 켤 수 있습니다.
# 켜져 있어도 지원자가 분석마다 따로 동의해야 자료가 전송됩니다.
# 서버에서만 읽으며 브라우저로 내려가지 않습니다.
ROLEFIT_ANTHROPIC_API_KEY=

# ── 정적 배포 전용 (Railway 에서는 비워 두세요) ───────────────
# GitHub Pages 처럼 저장소 하위 경로에 올릴 때만 씁니다.
# Railway 는 도메인 루트에 올라가므로 설정하면 자원 경로가 어긋납니다.
NEXT_PUBLIC_BASE_PATH=

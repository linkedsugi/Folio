# RoleFit Canvas 환경 변수
#
# 아무것도 설정하지 않아도 앱은 전부 동작합니다.
# 분석 엔진과 이력서 생성은 브라우저에서 돌고, 파일도 기기 안에서 읽습니다.

# ── Google 로그인 (선택) ───────────────────────────────────────
# 공개 클라이언트 ID 하나면 됩니다. 비밀키는 쓰지 않습니다.
# 만드는 곳: Google Cloud Console → API 및 서비스 → 사용자 인증 정보
#   · 애플리케이션 유형: 웹 애플리케이션
#   · 승인된 JavaScript 원본: 배포 주소 (예: https://linkedsugi.github.io)
# 비워 두면 로그인 버튼 대신 "로그인이 설정되지 않았습니다" 안내가 나옵니다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 관리자를 더 두고 싶을 때 (쉼표로 구분).
# linkedsugi@gmail.com 은 코드에 소유자로 고정되어 있어 여기 적지 않아도 됩니다.
NEXT_PUBLIC_ADMIN_EMAILS=

# ── 회원 정보 보관 (서버 배포에서만) ──────────────────────────
# 설정하면 이 폴더 아래 members.json 에 회원 목록을 보관합니다.
# 설정하지 않으면 서버 메모리에만 있어 재시작하면 사라집니다.
# 정적 배포(GitHub Pages)에는 서버가 없으므로 회원 목록이 브라우저마다 따로입니다.
ROLEFIT_DATA_DIR=

# ── 정밀 분석 (선택) ──────────────────────────────────────────
# 설정하면 JD·이력 분석이 LLM 기반으로 바뀝니다. 서버에서만 읽습니다.
ROLEFIT_ANTHROPIC_API_KEY=
